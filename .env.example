# ── Global Environment Variables ─────────────────────────────────────────────
# Copy this file to .env and adjust values for your local environment.

# ── App & Gateway ─────────────────────────────────────────────────────────────
APP_PORT=8080
APP_TIMEZONE=Asia/Jakarta
CORS_ORIGIN=http://localhost:3000

# ── Ingestion Service ─────────────────────────────────────────────────────────
GRPC_PORT=50051
INGESTION_API_KEY=fleet-secret-key-123

# ── MySQL ─────────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=fleet_tracking

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASS=

# ── Kafka ─────────────────────────────────────────────────────────────────────
KAFKA_BROKER=localhost:9092
KAFKA_TOPIC=location.events
KAFKA_GROUP_ID=tracking-service

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=info
