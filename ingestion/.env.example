# ── Ingestion Service Environment Variables ──────────────────────────────────
# Copy this file to .env and adjust values for your environment.
# Run the service from this directory: cd ingestion && go run .

# ── gRPC ─────────────────────────────────────────────────────────────────────
# TCP port for the gRPC server.
# Default: 50051
GRPC_PORT=50051

# ── Kafka ─────────────────────────────────────────────────────────────────────
# Comma-separated list of Kafka broker addresses.
# Default: localhost:9092
KAFKA_BROKER=localhost:9092

# Kafka topic to publish location events to.
# Default: location.events
KAFKA_TOPIC=location.events

# ── Logging ───────────────────────────────────────────────────────────────────
# Log verbosity level: debug | info | warn | error
# Default: info
LOG_LEVEL=info
