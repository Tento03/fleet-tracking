# ── Ingestion Service Environment Variables ──────────────────────────────────
# Copy this file to .env and fill in the values for your environment.
# The service reads .env from the directory it is run from (cd ingestion && go run .).

# TCP port for the gRPC server.
# Default: 50051
GRPC_PORT=50051

# Log verbosity level: debug | info | warn | error
# Default: info
LOG_LEVEL=info

# ── Kafka (filled in Prompt 2) ───────────────────────────────────────────────
# Comma-separated list of Kafka broker addresses.
# KAFKA_BROKERS=localhost:9092

# Kafka topic to publish location events to.
# KAFKA_TOPIC=location.events
