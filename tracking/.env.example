# ── Tracking Service Environment Variables ───────────────────────────────────
# Copy this file to .env and adjust values for your local environment.
# Run the service from this directory: cd tracking && go run .

# ── App ───────────────────────────────────────────────────────────────────────
APP_PORT=8080
APP_TIMEZONE=Asia/Jakarta

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:3000

# ── MySQL ─────────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=fleet_tracking

# ── Redis ─────────────────────────────────────────────────────────────────────
# On Windows: use Memurai, Redis for Windows, or WSL2 with Redis.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASS=

# ── Kafka ─────────────────────────────────────────────────────────────────────
KAFKA_BROKER=localhost:9092
KAFKA_TOPIC=location.events
KAFKA_GROUP_ID=tracking-service

# ── Logging ───────────────────────────────────────────────────────────────────
# Log verbosity level: debug | info | warn | error
LOG_LEVEL=info
