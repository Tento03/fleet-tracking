# ── Tracking Service Environment Variables ───────────────────────────────────
# Run from tracking/: cd tracking && go run .

APP_PORT=8080
APP_TIMEZONE=Asia/Jakarta
CORS_ORIGIN=http://localhost:3000

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=fleet_tracking

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASS=

KAFKA_BROKER=localhost:9092
KAFKA_TOPIC=location.events
KAFKA_GROUP_ID=tracking-service

LOG_LEVEL=info
